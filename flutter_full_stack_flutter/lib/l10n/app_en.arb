{
  "@@locale": "en",

  "headline": "Say hello.",
  "@headline": {
    "description": "Main heading on the greetings screen."
  },

  "tagline": "Your name travels to the Serverpod endpoint and comes back as a typed model.",
  "@tagline": {
    "description": "Sentence under the heading explaining what the screen does."
  },

  "nameFieldLabel": "Your name",
  "@nameFieldLabel": {
    "description": "Label of the text field the user types a name into."
  },

  "sendTooltip": "Send",
  "@sendTooltip": {
    "description": "Tooltip on the button that sends the name to the server."
  },

  "responseLabel": "From the server",
  "@responseLabel": {
    "description": "Caption above a successful response. Shown upper-cased."
  },

  "errorLabel": "The call failed",
  "@errorLabel": {
    "description": "Caption above an error response. Shown upper-cased."
  },

  "callingServer": "Calling the server",
  "@callingServer": {
    "description": "Shown while the request is in flight."
  },

  "themeTooltip": "Theme: {mode}",
  "@themeTooltip": {
    "description": "Tooltip on the theme switch button.",
    "placeholders": {
      "mode": { "type": "String", "example": "dark" }
    }
  },

  "themeModeSystem": "following the device",
  "@themeModeSystem": {
    "description": "Theme is whatever the device asks for."
  },

  "themeModeLight": "light",
  "@themeModeLight": { "description": "Theme is pinned to light." },

  "themeModeDark": "dark",
  "@themeModeDark": { "description": "Theme is pinned to dark." },

  "languageTooltip": "Language: {name}",
  "@languageTooltip": {
    "description": "Tooltip on the language switch button.",
    "placeholders": {
      "name": { "type": "String", "example": "English" }
    }
  },

  "languageSystem": "following the device",
  "@languageSystem": {
    "description": "Language is whatever the device asks for."
  },

  "languageEnglish": "English",
  "@languageEnglish": { "description": "Name of the English locale." },

  "languageKorean": "한국어",
  "@languageKorean": {
    "description": "Name of the Korean language, in that language."
  },

  "languagePortuguese": "Português",
  "@languagePortuguese": {
    "description": "Name of the Portuguese locale, in that language."
  },

  "languageSpanish": "Español",
  "@languageSpanish": {
    "description": "Name of the Spanish language, in that language."
  },

  "pickLanguageHeadline": "What are you practising?",
  "@pickLanguageHeadline": {
    "description": "Main heading on the language chooser."
  },

  "pickLanguageTagline": "Each language has its own pack. Once it is on the device, practice works offline.",
  "@pickLanguageTagline": {
    "description": "Sentence under the chooser heading."
  },

  "packReady": "On this device",
  "@packReady": {
    "description": "Shown on a language whose pack is already downloaded."
  },

  "packMissing": "{megabytes} MB to download",
  "@packMissing": {
    "description": "Shown on a language whose pack still has to be fetched.",
    "placeholders": { "megabytes": { "type": "int" } }
  },

  "packDownloading": "Downloading the pack",
  "@packDownloading": {
    "description": "On a language card while its pack downloads; a ring beside it shows how far."
  },

  "packChecking": "Checking the pack",
  "@packChecking": {
    "description": "On a language card for the couple of seconds after its pack has downloaded, while it is checked against its SHA-256."
  },

  "packInterrupted": "Stopped partway. Tap to pick up where it left off.",
  "@packInterrupted": {
    "description": "On a language card whose download failed. What arrived is kept, so a tap resumes it."
  },

  "packDamaged": "Arrived damaged. Tap to download it again.",
  "@packDamaged": {
    "description": "On a language card whose downloaded pack did not match its SHA-256. It was deleted, so a tap downloads it from the start."
  },

  "practicePosition": "{current} of {total}",
  "@practicePosition": {
    "description": "Which prompt of the deck is on screen.",
    "placeholders": {
      "current": { "type": "int" },
      "total": { "type": "int" }
    }
  },

  "practiceRecord": "Record",
  "@practiceRecord": {
    "description": "Button that starts recording the learner reading the sentence."
  },

  "practiceStop": "Stop",
  "@practiceStop": {
    "description": "Button that ends the recording and scores it."
  },

  "practiceScoring": "Scoring",
  "@practiceScoring": {
    "description": "Shown while the recording is being scored."
  },

  "practiceNoMicrophone": "Practice needs the microphone. Turn it on in settings.",
  "@practiceNoMicrophone": {
    "description": "Shown when microphone permission was refused."
  },

  "practiceAccuracy": "Pronunciation",
  "@practiceAccuracy": {
    "description": "Caption for the phoneme accuracy part of the score."
  },

  "practiceFluency": "Fluency",
  "@practiceFluency": {
    "description": "Caption for the rhythm and pausing measure, reported beside the score."
  },

  "practiceFluencyDiagnostic": "diagnostic only",
  "@practiceFluencyDiagnostic": {
    "description": "Says the fluency number does not count towards the score."
  },

  "practiceRhythmDetail": "{rate} phonemes per second, {pauses, plural, =0{no pauses} =1{1 pause} other{{pauses} pauses}}",
  "@practiceRhythmDetail": {
    "description": "The raw rhythm measurements behind the fluency number.",
    "placeholders": {
      "rate": { "type": "String" },
      "pauses": { "type": "int" }
    }
  },

  "practiceHeardInstead": "sounded like {phoneme}",
  "@practiceHeardInstead": {
    "description": "Names the phoneme the model heard in place of the right one.",
    "placeholders": { "phoneme": { "type": "String" } }
  },

  "practiceNextSentence": "Next sentence",
  "@practiceNextSentence": {
    "description": "Moves practice on to the next prompt."
  },

  "practiceTryAgain": "Try again",
  "@practiceTryAgain": {
    "description": "Records another attempt at the same sentence."
  },

  "practiceUnavailable": "Practice could not open.",
  "@practiceUnavailable": {
    "description": "Shown when the practice screen could not load at all."
  },

  "practiceRecordFailed": "The microphone could not start. Try again.",
  "@practiceRecordFailed": {
    "description": "Shown when recording could not begin."
  },

  "practiceScoreFailed": "This attempt could not be scored. Record it again.",
  "@practiceScoreFailed": {
    "description": "Shown when a recording was made but could not be scored."
  },

  "practiceTooShort": "That was too short. Tap Stop once you have finished reading.",
  "@practiceTooShort": {
    "description": "Shown when a recording holds too little audio to score."
  },

  "practiceNotHeard": "We could not hear you read it. Read the whole text, close to the microphone.",
  "@practiceNotHeard": {
    "description": "Shown when a recording holds no speech, or only a fragment of the prompt."
  },

  "practiceOpenSettings": "Open settings",
  "@practiceOpenSettings": {
    "description": "Button that opens the app's page in the system settings, where the microphone can be allowed."
  },

  "licensesTooltip": "Licenses",
  "@licensesTooltip": {
    "description": "Tooltip of the app bar button that opens the licences page, including the pronunciation models'."
  },

  "practiceListen": "Listen",
  "@practiceListen": {
    "description": "Button that reads the sentence aloud, in the accent it is scored against, for the learner to copy."
  },

  "practiceListenStop": "Stop reading",
  "@practiceListenStop": {
    "description": "The listen button while the sentence is being read aloud: stops the reading."
  },

  "practiceSoundsOn": "Sounds on",
  "@practiceSoundsOn": {
    "description": "Tooltip of the button that turns off the scenes', the cat's and the score's sounds, while they are on. The sentence can still be listened to."
  },

  "practiceSoundsOff": "Sounds off",
  "@practiceSoundsOff": {
    "description": "Tooltip of the same button while those sounds are off."
  },

  "practiceScoreDetails": "Pronunciation {score}. See details",
  "@practiceScoreDetails": {
    "description": "Label of the round score badge beside the record button. Tapping it opens the full result: fluency, rhythm and every phoneme that went wrong.",
    "placeholders": {
      "score": { "type": "int", "example": "57" }
    }
  },

  "practiceHearWord": "Hear \u201c{word}\u201d",
  "@practiceHearWord": {
    "description": "Tooltip of the speaker button that reads one word of the sentence aloud.",
    "placeholders": {
      "word": { "type": "String", "example": "weather" }
    }
  },

  "practiceReplay": "Hear yourself",
  "@practiceReplay": {
    "description": "Button on the learner's own recording, drawn as a voice message: plays their last attempt back to them while the sentence lights up word by word.",
    "placeholders": {}
  },

  "practiceReplayStop": "Stop playback",
  "@practiceReplayStop": {
    "description": "The same button while the learner's recording is playing: stops it."
  },

  "practiceHearWordYours": "Hear how you said \u201c{word}\u201d",
  "@practiceHearWordYours": {
    "description": "Tooltip of the button that plays back just one word, cut from the learner's own recording, to compare with how it should sound.",
    "placeholders": {
      "word": { "type": "String", "example": "weather" }
    }
  }
}
