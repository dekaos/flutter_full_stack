<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen before Android 12: CNA's logo, white on CNA's red,
     in the middle - the first frame of the animated splash.
     splash_mark.png is drawn by tool/render_branding.dart. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_ground" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_mark" />
    </item>
</layer-list>
