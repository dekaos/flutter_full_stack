{
    "version": "2.0.0",
    "tasks": [
        {
            // Starts with the workspace, not with a launch, which is the whole
            // point: a *.g.dart edited or deleted after the app is already
            // running is still regenerated. The preLaunchTask below only ever
            // fires once, at F5, so on its own it leaves that gap open.
            //
            // Cheap to leave running: measured at 0.03% of one core over a
            // minute idle - it sleeps on filesystem events rather than polling
            // - and around 90 MB resident once the analyzer drops its caches
            // after a build. A rebuild after a save lands in roughly 1.4s.
            //
            // VS Code asks once per workspace to allow automatic tasks. Until
            // that is accepted this silently does not run, so if generated code
            // stops keeping up, check that first: Command Palette →
            // "Tasks: Manage Automatic Tasks".
            //
            // No background problemMatcher on purpose. Nothing waits on this
            // task, so there is nothing to signal readiness to, and an empty
            // matcher is what the other tasks here use to stop VS Code asking
            // which matcher to apply. It must also never get "close": true - a
            // watcher that closes is a watcher that stopped.
            //
            // This is the ONLY build_runner entry point wired into the editor,
            // and it has to stay that way. build_runner allows one process per
            // package: a second one does not queue behind this, it asks this
            // one to exit ("Exiting as requested by another build_runner
            // process") and takes over. A one-shot pass on preLaunchTask
            // therefore silently kills the watcher on the first F5, leaving
            // nothing watching for the rest of the session. Use
            // `melos run generate` from a terminal for a full pass instead.
            "label": "flutter_codegen_watch",
            "type": "shell",
            "command": "dart run melos:melos run generate:watch --no-select",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "runOptions": {
                "runOn": "folderOpen"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
        {
            // preLaunchTask for the server configurations in launch.json.
            "label": "server_preflight",
            "type": "shell",
            // The port check runs first, and its failure aborts the launch.
            // Serverpod does not exit when it cannot bind - it logs the error,
            // stays alive and stops answering SIGTERM - so without this an F5
            // on top of a running server leaves a process behind that only
            // `kill -9` removes. The melos server scripts run the same check.
            "command": "dart run tool/require_free_ports.dart 8080 8081 8082 && cd flutter_full_stack_server && docker compose --progress quiet up --detach",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            // Compose writes its status lines to stderr, so without an empty
            // matcher VS Code prompts to pick one on every launch.
            "problemMatcher": [],
            "presentation": {
                // "silent" hides the panel while the task succeeds and reveals
                // it when it fails, which is the only place the guard's message
                // can be read. It deliberately does not also close: a closing
                // panel takes the message with it and leaves a refused launch
                // showing nothing but "terminated with exit code 1". The panel
                // is "dedicated", so the same terminal is reused rather than
                // one accumulating per launch.
                "reveal": "silent",
                "panel": "dedicated"
            }
        }
    ]
}
