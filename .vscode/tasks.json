{
    "version": "2.0.0",
    "tasks": [
        {
            // preLaunchTask for the server configurations in launch.json.
            "label": "server_preflight",
            "type": "shell",
            // The port check runs first, and its failure aborts the launch.
            // Serverpod does not exit when it cannot bind - it logs the error,
            // stays alive and stops answering SIGTERM - so without this an F5
            // on top of a running server leaves a process behind that only
            // `kill -9` removes. The melos server scripts run the same check.
            "command": "dart run tool/require_free_ports.dart 8080 8081 8082 && cd flutter_full_stack_server && docker compose --progress quiet up --detach",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            // Compose writes its status lines to stderr, so without an empty
            // matcher VS Code prompts to pick one on every launch.
            "problemMatcher": [],
            "presentation": {
                // "silent" keeps the panel hidden on success and reveals it on
                // failure. It must not also close: with "close": true the panel
                // disappears before it can be read, and a refused launch shows
                // only "terminated with exit code 1" - never the port and pid
                // that explain it.
                "reveal": "silent",
                "panel": "dedicated"
            }
        }
    ]
}
